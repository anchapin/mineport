# Application
NODE_ENV=development
PORT=3000
HOST=localhost
LOG_LEVEL=info

# Database (no defaults for credentials)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mineport
DB_USER=postgres
DB_PASSWORD=

# MongoDB (preferred env-based configuration)
MONGODB_URI=mongodb://localhost:27017/minecraft-mod-converter

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# LLM Provider (do not commit real keys)
LLM_API_KEY=
LLM_ENDPOINT=
LLM_MODEL=gpt-4

# GitHub
GITHUB_TOKEN=

# Slack Webhook (do not commit real URLs)
SLACK_WEBHOOK_URL=

# Notes:
# - Leave sensitive values empty and set them in your secret manager or CI variables.
# - Never commit a .env file with real secrets. This .env.example is safe to commit.